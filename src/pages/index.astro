<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The KMC Experience - NYC Culture & Consciousness</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #4ecdc4;
            --secondary: #ff6b6b;
            --dark-bg: #0f3460;
            --darker-bg: #16213e;
            --card-bg: rgba(255, 255, 255, 0.1);
            --text: #fff;
            --transition: all 0.3s ease;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);
            color: var(--text);
            line-height: 1.7;
            min-height: 100vh;
            overflow-x: hidden;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* Header Styles */
        header {
            background: rgba(0,0,0,0.8);
            backdrop-filter: blur(10px);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            padding: 1rem 0;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.5);
            border-bottom: 1px solid rgba(78, 205, 196, 0.1);
        }
        
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }
        
        .logo {
            font-size: 1.8rem;
            font-weight: bold;
            background: linear-gradient(45deg, var(--secondary), var(--primary), #45b7d1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            transition: var(--transition);
        }
        
        .logo:hover {
            transform: scale(1.05);
        }
        
        .nav-links {
            display: flex;
            list-style: none;
            gap: 1.5rem;
            flex-wrap: wrap;
        }
        
        .nav-links a {
            color: var(--text);
            text-decoration: none;
            transition: var(--transition);
            padding: 0.5rem 0;
            position: relative;
            font-weight: 500;
        }
        
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--primary);
            transition: var(--transition);
        }
        
        .nav-links a:hover {
            color: var(--primary);
        }
        
        .nav-links a:hover::after {
            width: 100%;
        }
        
        .hamburger {
            display: none;
            background: none;
            border: none;
            color: var(--text);
            font-size: 1.5rem;
            cursor: pointer;
        }
        
        /* NEW ANIMATED HERO SECTION */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            text-align: center;
            padding: 8rem 1rem 5rem;
        }
        
        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 20% 30%, rgba(78, 205, 196, 0.1) 0%, transparent 40%),
                radial-gradient(circle at 80% 70%, rgba(255, 107, 107, 0.1) 0%, transparent 40%),
                url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="1" fill="%23ffffff" opacity="0.1"/><circle cx="80" cy="40" r="1" fill="%23ffffff" opacity="0.1"/><circle cx="40" cy="80" r="1" fill="%23ffffff" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
            z-index: -1;
        }
        
        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 800px;
        }
        
        .title {
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            margin-bottom: 1.5rem;
            background: linear-gradient(45deg, var(--secondary), var(--primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            line-height: 1.2;
            animation: titlePulse 3s infinite;
        }
        
        @keyframes titlePulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        
        .subtitle {
            font-size: clamp(1.1rem, 2.5vw, 1.4rem);
            margin-bottom: 2.5rem;
            opacity: 0.9;
        }
        
        /* Culture Elements */
        .culture-elements {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 2rem;
            margin: 3rem 0;
        }
        
        .culture-card {
            width: 220px;
            height: 220px;
            border-radius: 10px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            transition: var(--transition);
            padding: 1.5rem;
            position: relative;
            overflow: hidden;
        }
        
        .culture-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
            border-color: rgba(78, 205, 196, 0.3);
        }
        
        .culture-icon {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            color: var(--primary);
            animation: float 3s infinite ease-in-out;
        }
        
        .culture-title {
            font-size: 1.4rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
            color: var(--secondary);
        }
        
        .culture-desc {
            font-size: 0.9rem;
            opacity: 0.8;
            text-align: center;
        }
        
        /* Animated Elements */
        .animated-element {
            position: absolute;
            z-index: 1;
            opacity: 0.3;
            font-size: 1.5rem;
            animation: float 8s infinite ease-in-out;
            pointer-events: none;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0) translateX(0) rotate(0deg); }
            25% { transform: translateY(-20px) translateX(10px) rotate(5deg); }
            50% { transform: translateY(0) translateX(20px) rotate(0deg); }
            75% { transform: translateY(20px) translateX(10px) rotate(-5deg); }
        }
        
        /* Background Elements */
        .background-element {
            position: absolute;
            z-index: 0;
            opacity: 0.1;
            font-size: 10rem;
            animation: rotate 30s infinite linear;
            pointer-events: none;
        }
        
        @keyframes rotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .graffiti-text {
            position: absolute;
            font-family: 'Arial Black', Arial, sans-serif;
            font-size: 5rem;
            opacity: 0.03;
            transform: rotate(-20deg);
            color: var(--primary);
            z-index: 0;
            pointer-events: none;
        }
        
        /* Audio Player */
        .audio-player {
            background: rgba(0,0,0,0.3);
            padding: 1.5rem;
            border-radius: 15px;
            margin: 1.5rem auto 2rem;
            max-width: 500px;
            width: 100%;
            text-align: left;
        }

        .audio-player p {
            font-style: italic;
            margin-bottom: 1rem;
            font-size: 1.1rem;
            color: var(--primary);
            text-align: center;
        }
        
        audio {
            width: 100%;
            border-radius: 50px;
        }

        audio::-webkit-media-controls-panel {
            background: rgba(0,0,0,0.5);
        }
        
        .cta-button {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(45deg, var(--secondary), var(--primary));
            color: white;
            padding: 1rem 2.5rem;
            text-decoration: none;
            border-radius: 50px;
            font-weight: bold;
            transition: var(--transition);
            box-shadow: 0 5px 20px rgba(255, 107, 107, 0.3);
            font-size: 1.1rem;
            margin-top: 1rem;
            border: none;
            cursor: pointer;
        }
        
        .cta-button:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(78, 205, 196, 0.4);
        }
        
        /* Ecosystem Section */
        .ecosystem {
            padding: 3rem;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin: 3rem 0;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }
        
        .ecosystem h2 {
            text-align: center;
            font-size: clamp(1.8rem, 4vw, 2.5rem);
            margin-bottom: 2rem;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.8rem;
        }
        
        .platforms {
            list-style: none;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1rem;
        }
        
        .platforms li {
            margin-bottom: 0.5rem;
            transition: var(--transition);
        }
        
        .platforms a {
            text-decoration: none;
            font-weight: bold;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 1rem;
            border-radius: 10px;
            background: rgba(30, 40, 65, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: var(--transition);
        }
        
        .platforms a:hover {
            background: rgba(78, 205, 196, 0.1);
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            border-color: rgba(78, 205, 196, 0.3);
        }
        
        .platform-icon {
            font-size: 1.5rem;
            min-width: 30px;
            text-align: center;
        }
        
        /* Section Styles */
        .section {
            margin: 4rem 0;
            padding: 3rem;
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            border: 1px solid rgba(255,255,255,0.1);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        .section h2 {
            font-size: clamp(1.8rem, 4vw, 2.5rem);
            margin-bottom: 1.5rem;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }
        
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }
        
        .card {
            background: var(--card-bg);
            padding: 2rem;
            border-radius: 10px;
            transition: all 0.3s;
            border: 1px solid rgba(255,255,255,0.05);
            display: flex;
            flex-direction: column;
        }
        
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
            border-color: rgba(78, 205, 196, 0.3);
        }
        
        .card h3 {
            color: var(--secondary);
            margin-bottom: 1rem;
            font-size: 1.4rem;
        }
        
        /* Video Section */
        .video-container {
            position: relative;
            width: 100%;
            padding-top: 56.25%; /* 16:9 Aspect Ratio */
            border-radius: 15px;
            overflow: hidden;
            margin: 2rem 0;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        
        .video-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }
        
        /* Books Section */
        .book-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }
        
        .book-card {
            background: var(--card-bg);
            border-radius: 15px;
            overflow: hidden;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
            height: 100%;
            border: 1px solid rgba(255,255,255,0.05);
        }
        
        .book-card:hover {
            transform: scale(1.03);
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }
        
        .book-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .book-card:hover img {
            transform: scale(1.05);
            transition: transform 0.5s;
        }
        
        .book-info {
            padding: 1.5rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        .book-price {
            font-size: 1.5rem;
            color: var(--primary);
            font-weight: bold;
            margin: 1rem 0;
        }
        
        .buy-button {
            display: block;
            background: linear-gradient(45deg, var(--secondary), var(--primary));
            color: white;
            padding: 0.8rem 1.5rem;
            text-decoration: none;
            border-radius: 25px;
            text-align: center;
            font-weight: bold;
            transition: all 0.3s;
            margin-top: auto;
            border: none;
            cursor: pointer;
        }
        
        .buy-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }
        
        /* Community Section */
        .profile-section {
            background: linear-gradient(135deg, rgba(255,107,107,0.1), rgba(78,205,196,0.1));
        }
        
        .profile-form {
            max-width: 600px;
            margin: 0 auto;
        }
        
        .form-group {
            margin-bottom: 1.5rem;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--primary);
            font-weight: 500;
        }
        
        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 0.8rem 1rem;
            border: 1px solid rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.07);
            color: white;
            border-radius: 8px;
            font-family: inherit;
            font-size: 1rem;
            transition: all 0.3s;
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(78, 205, 196, 0.2);
        }
        
        .form-group input::placeholder,
        .form-group textarea::placeholder {
            color: rgba(255,255,255,0.5);
        }
        
        .interest-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 1rem;
        }
        
        .tag {
            background: rgba(78,205,196,0.2);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.9rem;
            transition: all 0.3s;
        }

        .tag:hover {
            background: rgba(78,205,196,0.4);
            transform: translateY(-2px);
        }
        
        /* Footer */
        footer {
            background: rgba(0,0,0,0.9);
            padding: 3rem 0;
            text-align: center;
        }
        
        .social-links {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin: 2rem 0;
            flex-wrap: wrap;
        }
        
        .social-links a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            color: var(--primary);
            font-size: 1.5rem;
            transition: all 0.3s;
            text-decoration: none;
        }
        
        .social-links a:hover {
            background: linear-gradient(135deg, var(--secondary), var(--primary));
            color: white;
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(78, 205, 196, 0.3);
        }
        
        .back-to-top {
            display: inline-block;
            margin-top: 2rem;
            color: var(--primary);
            text-decoration: none;
            font-weight: bold;
            transition: all 0.3s;
        }

        .back-to-top:hover {
            color: var(--secondary);
            transform: translateY(-3px);
        }
        
        /* Performance Optimizations */
        .animated-element, .background-element, .graffiti-text {
            will-change: transform;
        }
        
        /* Responsive Design */
        @media (max-width: 768px) {
            .hamburger {
                display: block;
            }
            
            .nav-links {
                position: fixed;
                top: 70px;
                left: -100%;
                flex-direction: column;
                background: rgba(0,0,0,0.95);
                width: 100%;
                text-align: center;
                padding: 2rem 0;
                gap: 1.5rem;
                transition: 0.3s;
                z-index: 999;
            }
            
            .nav-links.active {
                left: 0;
            }
            
            .hero {
                padding-top: 8rem;
            }
            
            .section, .ecosystem {
                padding: 2rem;
            }
            
            .culture-elements {
                flex-direction: column;
                align-items: center;
            }
            
            .culture-card {
                width: 100%;
                max-width: 300px;
            }
            
            .title {
                font-size: 2.5rem;
            }
            
            /* Mobile optimization */
            .animated-element {
                animation-duration: 12s;
                font-size: 1.2rem;
            }
            .background-element {
                font-size: 6rem;
            }
            .graffiti-text {
                font-size: 3rem;
            }
        }

        @media (max-width: 480px) {
            .section, .ecosystem {
                padding: 1.5rem;
            }
            
            .book-grid, .platforms {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="container">
            <div class="logo">The KMC Experience</div>
            <button class="hamburger" id="hamburger">
                <i class="fas fa-bars"></i>
            </button>
            <ul class="nav-links" id="navLinks">
                <li><a href="#home">Home</a></li>
                <li><a href="#mind">Mind & Life</a></li>
                <li><a href="#culture">Culture</a></li>
                <li><a href="#games">Games & Tech</a></li>
                <li><a href="#sports">Sports</a></li>
                <li><a href="#books">Books</a></li>
                <li><a href="#community">Community</a></li>
                <li><a href="#support">Support</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        <!-- Animated Hero Section -->
        <section id="home" class="hero">
            <!-- Background elements -->
            <div class="background-element" style="top: 10%; left: 5%;">🥊</div>
            <div class="background-element" style="top: 15%; right: 10%;">🎤</div>
            <div class="background-element" style="bottom: 20%; left: 15%;">🎧</div>
            
            <div class="graffiti-text" style="top: 20%; left: 5%;">BRONX</div>
            <div class="graffiti-text" style="bottom: 15%; right: 5%;">HIP HOP</div>
            
            <!-- Floating elements will be added by JavaScript -->
            <div class="hero-content">
                <h1 class="title">The KMC Experience</h1>
                <p class="subtitle">Real thoughts from the Bronx. ADHD-fueled deep dives into culture, tech, consciousness, and creativity.</p>
                
                <div class="culture-elements">
                    <div class="culture-card">
                        <div class="culture-icon">
                            <i class="fas fa-microphone-alt"></i>
                        </div>
                        <h3 class="culture-title">The Mic</h3>
                        <p class="culture-desc">Where stories are told and voices are heard</p>
                    </div>
                    
                    <div class="culture-card">
                        <div class="culture-icon">
                            <i class="fas fa-compact-disc"></i>
                        </div>
                        <h3 class="culture-title">The DJ</h3>
                        <p class="culture-desc">Setting the rhythm of the city</p>
                    </div>
                    
                    <div class="culture-card">
                        <div class="culture-icon">
                            <i class="fas fa-fist-raised"></i>
                        </div>
                        <h3 class="culture-title">The Fight</h3>
                        <p class="culture-desc">Boxing spirit of the Bronx streets</p>
                    </div>
                </div>
                
                <div class="audio-player">
                    <p><i class="fas fa-microphone-alt"></i> "Welcome to The KMC Experience — where culture meets soul, and every story has a beat..."</p>
                    <audio controls>
                        <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mpeg">
                        Your browser does not support the audio element.
                    </audio>
                </div>
                
                <a href="#ecosystem" class="cta-button" id="exploreBtn">
                    Explore Ecosystem <i class="fas fa-arrow-down"></i>
                </a>
            </div>
        </section>

        <!-- Ecosystem Section -->
        <section id="ecosystem" class="ecosystem">
            <h2>🌐 Join the KMC Experience Ecosystem</h2>
            <ul class="platforms">
                <li><a href="https://youtube.com/@yourchannel" target="_blank">
                    <span class="platform-icon">🔴</span>
                    <span>YouTube – Tutorials & Vlogs</span>
                </a></li>
                <li><a href="https://instagram.com/yourhandle" target="_blank">
                    <span class="platform-icon">📷</span>
                    <span>Instagram – Reels & Lifestyle</span>
                </a></li>
                <li><a href="https://tiktok.com/@yourhandle" target="_blank">
                    <span class="platform-icon">🎵</span>
                    <span>TikTok – Viral Clips & AI Content</span>
                </a></li>
                <li><a href="https://snapchat.com/add/yourhandle" target="_blank">
                    <span class="platform-icon">👻</span>
                    <span>Snapchat – Behind the Scenes</span>
                </a></li>
                <li><a href="https://twitter.com/yourhandle" target="_blank">
                    <span class="platform-icon">🧵</span>
                    <span>Twitter – Thoughts & Memes</span>
                </a></li>
                <li><a href="https://discord.gg/yourserver" target="_blank">
                    <span class="platform-icon">🟣</span>
                    <span>Discord – Community & Chat</span>
                </a></li>
                <li><a href="https://reddit.com/u/yourhandle" target="_blank">
                    <span class="platform-icon">🟥</span>
                    <span>Reddit – AMAs & Opinions</span>
                </a></li>
                <li><a href="https://t.me/yourchannel" target="_blank">
                    <span class="platform-icon">✈️</span>
                    <span>Telegram – Instant Updates</span>
                </a></li>
                <li><a href="https://onlyfans.com/yourhandle" target="_blank">
                    <span class="platform-icon">🧡</span>
                    <span>OnlyFans – Premium Fan Content</span>
                </a></li>
                <li><a href="https://patreon.com/yourhandle" target="_blank">
                    <span class="platform-icon">🎁</span>
