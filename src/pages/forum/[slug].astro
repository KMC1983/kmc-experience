---
// src/pages/forum/[slug].astro
// One page per post, built at compile time from the fake data file.
// getStaticPaths is how Astro knows which URLs to generate — one per post slug.
import ForumLayout from "../../layouts/ForumLayout.astro";
import { forumPosts } from "../../data/forumPosts.js";

export function getStaticPaths() {
  return forumPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Friendly labels + colors for social links, matching your main site's
// social ecosystem section. Add more platforms here as you need them.
const socialLabels = {
  instagram: { label: "Instagram", color: "#e1306c" },
  tiktok: { label: "TikTok", color: "#69c9d0" },
  meetup: { label: "Meetup Group", color: "#ff5252" },
  spotify: { label: "Spotify", color: "#1db954" },
};
---
<ForumLayout title={`${post.tagline} — The Cypher`}>
  <a class="back-link" href="/forum">&larr; Back to the feed</a>

  <article class="post-detail">
    <span class="post-category">{post.category}</span>
    <h1 class="post-title">{post.tagline}</h1>
    <p class="post-meta">{post.name}, {post.age}</p>

    <p class="post-bio">{post.bio}</p>

    <div class="tag-row">
      {post.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
    </div>

    {
      post.social && Object.keys(post.social).length > 0 && (
        <div class="social-row">
          {Object.entries(post.social).map(([key, url]) => {
            const meta = socialLabels[key] || { label: key, color: "#8c97af" };
            return (
              <a class="social-pill" href={url} style={`--pill-color:${meta.color}`}>
                {meta.label}
              </a>
            );
          })}
        </div>
      )
    }

    <button class="cosign-button" id="cosignBtn" data-count={post.coSigns}>
      <span class="cosign-icon">✊</span>
      <span id="cosignText">Co-Sign ({post.coSigns})</span>
    </button>
  </article>

  <section class="comments">
    <h2>{post.comments.length} Replies</h2>
    <div class="comment-list">
      {
        post.comments.map((comment) => (
          <div class="comment">
            <p class="comment-author">{comment.author}</p>
            <p class="comment-text">{comment.text}</p>
            <p class="comment-cosigns">✊ {comment.coSigns} co-signs</p>
          </div>
        ))
      }
    </div>

    <form class="reply-form" id="replyForm">
      <textarea placeholder="Add your reply..." rows="3"></textarea>
      <button type="submit">Post Reply</button>
      <p class="form-note">
        This form doesn't save anywhere yet — we'll wire it up once real
        accounts and a database are added.
      </p>
    </form>
  </section>
</ForumLayout>

<script>
  // Demo-only interactivity. Nothing here persists or hits a database —
  // it's just so the page feels alive while we're still on fake data.
  const cosignBtn = document.getElementById("cosignBtn");
  const cosignText = document.getElementById("cosignText");
  let clicked = false;

  cosignBtn?.addEventListener("click", () => {
    if (clicked) return;
    clicked = true;
    const base = parseInt(cosignBtn.dataset.count || "0", 10);
    cosignText.textContent = `Co-Sign (${base + 1})`;
    cosignBtn.classList.add("cosigned");
  });

  const replyForm = document.getElementById("replyForm");
  replyForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    alert("Replies will post for real once accounts + a database are set up.");
  });
</script>

<style>
  .back-link {
    display: inline-block;
    color: var(--text-muted);
    font-family: var(--font-label);
    font-size: 12px;
    margin-bottom: 20px;
  }

  .back-link:hover {
    color: var(--accent-gold);
  }

  .post-detail {
    background: var(--bg-panel);
    border: 1px solid var(--border-soft);
    border-radius: 18px;
    padding: 28px;
  }

  .post-category {
    display: inline-block;
    font-family: var(--font-label);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-rose);
    background: var(--accent-rose-soft);
    padding: 3px 9px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .post-title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 6px;
  }

  .post-meta {
    color: var(--text-muted);
    font-size: 14px;
    margin: 0 0 18px;
  }

  .post-bio {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-primary);
    margin: 0 0 20px;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .tag-pill {
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: 0.03em;
    color: var(--text-muted);
    border: 1px solid var(--border-soft);
    padding: 3px 8px;
    border-radius: 999px;
  }

  .social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }

  .social-pill {
    font-size: 12px;
    font-weight: 600;
    color: var(--pill-color);
    border: 1px solid var(--pill-color);
    padding: 6px 12px;
    border-radius: 999px;
  }

  .social-pill:hover {
    background: color-mix(in srgb, var(--pill-color) 15%, transparent);
  }

  .cosign-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent-gold-soft);
    border: 1px solid var(--accent-gold);
    color: var(--accent-gold);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    padding: 10px 18px;
    border-radius: 999px;
    cursor: pointer;
    transition: transform 0.1s ease;
  }

  .cosign-button:hover {
    transform: translateY(-1px);
  }

  .cosign-button.cosigned {
    background: var(--accent-gold);
    color: var(--bg-deep);
  }

  .comments {
    margin-top: 32px;
  }

  .comments h2 {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.4px;
    margin: 0 0 14px;
  }

  .comment-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  .comment {
    background: var(--bg-panel);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 14px 16px;
  }

  .comment-author {
    font-weight: 600;
    font-size: 13px;
    margin: 0 0 4px;
    color: var(--accent-rose);
  }

  .comment-text {
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 6px;
  }

  .comment-cosigns {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
  }

  .reply-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .reply-form textarea {
    background: var(--bg-panel);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 14px;
    padding: 12px 14px;
    resize: vertical;
  }

  .reply-form textarea:focus {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  .reply-form button {
    align-self: flex-start;
    background: var(--accent-rose);
    color: var(--bg-deep);
    border: none;
    font-weight: 700;
    font-size: 13px;
    padding: 10px 20px;
    border-radius: 999px;
    cursor: pointer;
  }

  .form-note {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
  }
</style>
