---
import { site, socialLinks } from '../data/site.js';

const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="social-links">
      {
        socialLinks.map((link) => (
          <a href={link.href} aria-label={link.label} target="_blank" rel="noopener noreferrer">
            <i class={link.icon}></i>
          </a>
        ))
      }
    </div>
    <p>&copy; {year} {site.title}. All rights reserved.</p>
    <p><em>Real culture, real conversations, real community.</em></p>
    <a href="#home" class="back-to-top">↑ Back to Top</a>
  </div>
</footer>
